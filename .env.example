# Base URL of the LupiraTasks API.
# Empty = same-origin (e.g. behind a reverse proxy that forwards /shared/*).
# Cross-origin deployment: point at the API and add this site's origin to the API's
# Auth:AllowedOrigins.
#   production: VITE_API_BASE_URL=https://tasks-api.lupira.com
#   local dev against a local API: VITE_API_BASE_URL=http://localhost:8080
VITE_API_BASE_URL=https://tasks-api.lupira.com
