<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>

    <!-- The BFF's own contract is a build output: every build writes openapi/LupiraTasksBff.json,
         which is what the TypeScript clients generate from. -->
    <OpenApiGenerateDocuments>true</OpenApiGenerateDocuments>
    <OpenApiGenerateDocumentsOnBuild>true</OpenApiGenerateDocumentsOnBuild>
    <OpenApiDocumentsDirectory>$(MSBuildThisFileDirectory)..\..\openapi</OpenApiDocumentsDirectory>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="LupiraTasksBff.UnitTests" />
    <InternalsVisibleTo Include="LupiraTasksBff.IntegrationTests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Lupira.Bff.Auth" Version="0.2.1" />
    <PackageReference Include="Lupira.Bff.OpenApi" Version="0.3.0" />
    <PackageReference Include="Lupira.Bff.Proxy" Version="0.2.1" />
    <PackageReference Include="Lupira.Build" Version="1.1.0" PrivateAssets="all" />
    <PackageReference Include="Lupira.Depz" Version="0.1.0" />
    <PackageReference Include="Lupira.Depz.Yarp" Version="0.1.0" />
    <PackageReference Include="Lupira.Hosting.Defaults" Version="0.1.0" />
    <PackageReference Include="Lupira.Hosting.Health" Version="0.1.0" />
    <PackageReference Include="Lupira.Hosting.Observability" Version="0.1.1" />
    <PackageReference Include="Microsoft.Extensions.ApiDescription.Server" Version="10.0.11">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Scalar.AspNetCore" Version="2.17.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- Embedded so the filter reads them identically during build-time generation, at runtime and
         under test — no dependency on the working directory. -->
    <EmbeddedResource Include="upstream\*.json" />
    <EmbeddedResource Include="exposed.json" />
  </ItemGroup>

</Project>
