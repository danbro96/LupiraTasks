{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Duende": "Warning",
      "Yarp": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Auth": {
    "Oidc": {
      "Authority": "https://auth.lupira.com/application/o/tasks/",
      "ClientId": "lupira-tasks",
      "ClientSecret": "",
      "Scopes": [ "openid", "profile", "email", "groups", "offline_access" ]
    }
  },
  "DataProtection": {
    "KeyPath": "/keys"
  },
  "ReverseProxy": {
    "Routes": {
      "tasks-shared": {
        "ClusterId": "tasks-api",
        "Order": 1,
        "AuthorizationPolicy": "Anonymous",
        "Match": { "Path": "/api/shared/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/api" } ]
      },
      "tasks-member": {
        "ClusterId": "tasks-api",
        "Order": 2,
        "AuthorizationPolicy": "Default",
        "Match": { "Path": "/api/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/api" } ]
      }
    },
    "Clusters": {
      "tasks-api": {
        "Destinations": {
          "primary": { "Address": "http://lupira-tasks-api:8080" }
        }
      }
    }
  }
}
