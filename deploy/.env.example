# Image tag to run (pin to the commit sha for rollback; default: latest).
IMAGE_TAG=latest

# Host port (4098x block, shared with the API at :40980; behind the tunnel at tasks.lupira.com).
TASKS_WEB_PORT=40981

# Authentik OIDC — the BFF reuses the SHARED public `lupira-tasks` client (PKCE, no secret), the same
# one mobile uses, so the forwarded token's issuer + aud already match what LupiraTasksApi validates.
# Add this web's redirect URI (https://tasks.lupira.com/signin-oidc) to that client in Authentik.
AUTH_AUTHORITY=https://auth.lupira.com/application/o/tasks/
AUTH_CLIENT_ID=lupira-tasks

# LupiraTasksApi the member surface proxies to (the signed-in user's forwarded token authenticates).
# Reach it on the internal network — a public hostname would leave the host and come back.
TASKS_API_BASE_URL=http://lupira-tasks-api:8080

# OpenTelemetry → OpenObserve collector (blank endpoint = export disabled). HEADERS carries the
# OpenObserve Basic auth (Authorization=Basic <base64>). Protocol/interval/attrs have compose defaults.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_METRIC_EXPORT_INTERVAL=300000
OTEL_RESOURCE_ATTRIBUTES=deployment.environment=prod,service.name=lupira-tasks-web
