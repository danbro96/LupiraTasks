{
  "name": "@lupira/tasks-api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "gen": "npm run spec && orval",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "spec": "dotnet build ../../src/LupiraTasksBff/LupiraTasksBff.csproj -v q --nologo"
  },
  "devDependencies": {
    "@danbro96/lupira-config-ts": "0.1.0",
    "@types/node": "^26.6.2",
    "orval": "^8.23.0"
  },
  "exports": {
    "./models": "./src/generated/models/index.ts",
    "./query/*": "./src/generated/query/*/*.ts",
    "./shared/*": "./src/generated/shared/*/*.ts",
    "./fetch/*": "./src/generated/fetch/*/*.ts"
  },
  "peerDependencies": {
    "@tanstack/react-query": "^5.90.2"
  },
  "peerDependenciesMeta": {
    "@tanstack/react-query": {
      "optional": true
    }
  },
  "dependencies": {
    "@danbro96/lupira-http": "0.1.0"
  }
